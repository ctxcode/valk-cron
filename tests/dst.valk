use cron
use valk.time

// Europe/Amsterdam 2026: 02:00 CET becomes 03:00 CEST on March 29, 03:00 CEST becomes 02:00
// CET on October 25

test "a time the clocks skip does not run" {
    let z = "Europe/Amsterdam"
    assert(check(nexts("30 2 * * *", "2026-03-28T12:00:00+01:00", 2, z), "2026-03-30 02:30:00 +02:00 2026-03-31 02:30:00 +02:00"))
    assert(check(prevs("30 2 * * *", "2026-03-30T00:00:00+02:00", 1, z), "2026-03-28 02:30:00 +01:00"))
    assert(check(nexts("*/30 * * * *", "2026-03-29T01:00:00+01:00", 3, z), "2026-03-29 01:30:00 +01:00 2026-03-29 03:00:00 +02:00 2026-03-29 03:30:00 +02:00"))
    assert(check(prevs("*/30 * * * *", "2026-03-29T03:30:00+02:00", 3, z), "2026-03-29 03:00:00 +02:00 2026-03-29 01:30:00 +01:00 2026-03-29 01:00:00 +01:00"))
    assert(check(nexts("0 3 * * *", "2026-03-28T12:00:00+01:00", 1, z), "2026-03-29 03:00:00 +02:00"))
    assert(check(nexts("59 1 * * *", "2026-03-28T12:00:00+01:00", 1, z), "2026-03-29 01:59:00 +01:00"))
}

test "a time that happens twice runs once" {
    let z = "Europe/Amsterdam"
    assert(check(nexts("30 2 * * *", "2026-10-24T12:00:00+02:00", 2, z), "2026-10-25 02:30:00 +02:00 2026-10-26 02:30:00 +01:00"))
    assert(check(prevs("30 2 * * *", "2026-10-26T00:00:00+01:00", 2, z), "2026-10-25 02:30:00 +02:00 2026-10-24 02:30:00 +02:00"))
    // From inside the second pass, the first one already ran
    assert(check(nexts("0,30 2 * * *", "2026-10-25T02:10:00+01:00", 1, z), "2026-10-26 02:00:00 +01:00"))
    assert(check(prevs("30 2 * * *", "2026-10-25T02:45:00+01:00", 1, z), "2026-10-25 02:30:00 +02:00"))
    assert(check(prevs("0 2 * * *", "2026-10-25T02:10:00+01:00", 1, z), "2026-10-25 02:00:00 +02:00"))
    assert(check(nexts("0 2 * * *", "2026-10-25T02:00:00+02:00", 1, z), "2026-10-26 02:00:00 +01:00"))
}

test "an hourly schedule runs through both passes" {
    let z = "Europe/Amsterdam"
    assert(check(nexts("*/30 * * * *", "2026-10-25T01:00:00+02:00", 6, z), "2026-10-25 01:30:00 +02:00 2026-10-25 02:00:00 +02:00 2026-10-25 02:30:00 +02:00 2026-10-25 02:00:00 +01:00 2026-10-25 02:30:00 +01:00 2026-10-25 03:00:00 +01:00"))
    assert(check(prevs("*/30 * * * *", "2026-10-25T03:00:00+01:00", 5, z), "2026-10-25 02:30:00 +01:00 2026-10-25 02:00:00 +01:00 2026-10-25 02:30:00 +02:00 2026-10-25 02:00:00 +02:00 2026-10-25 01:30:00 +02:00"))
    assert(check(nexts("0 * * * *", "2026-10-25T00:00:00+02:00", 4, z), "2026-10-25 01:00:00 +02:00 2026-10-25 02:00:00 +02:00 2026-10-25 02:00:00 +01:00 2026-10-25 03:00:00 +01:00"))
    assert(check(nexts("45 * * * *", "2026-10-25T02:50:00+02:00", 2, z), "2026-10-25 02:45:00 +01:00 2026-10-25 03:45:00 +01:00"))
    assert(check(nexts("0 0 * * * *", "2026-10-25T02:10:00+01:00", 1, z), "2026-10-25 03:00:00 +01:00"))
}

test "other zones" {
    // New York: 01:00-02:00 repeats on November 1, 02:00-03:00 is skipped on March 8
    let z = "America/New_York"
    assert(check(nexts("30 1 * * *", "2026-10-31T12:00:00-04:00", 2, z), "2026-11-01 01:30:00 -04:00 2026-11-02 01:30:00 -05:00"))
    assert(check(nexts("30 2 * * *", "2026-03-07T12:00:00-05:00", 2, z), "2026-03-09 02:30:00 -04:00 2026-03-10 02:30:00 -04:00"))
    // Lord Howe moves half an hour: 02:00 becomes 02:30 on October 4 2026
    let lh = "Australia/Lord_Howe"
    assert(check(nexts("*/15 * * * *", "2026-10-04T01:30:00+10:30", 4, lh), "2026-10-04 01:45:00 +10:30 2026-10-04 02:30:00 +11:00 2026-10-04 02:45:00 +11:00 2026-10-04 03:00:00 +11:00"))
    assert(check(nexts("15 2 * * *", "2026-10-03T12:00:00+10:30", 1, lh), "2026-10-05 02:15:00 +11:00"))
    // A fixed offset has no changes
    let schedule = cron.parse("0 9 * * *") !!
    let at = (time.DateTime.new(2026, 10, 4) !!).in_zone(time.fixed_zone(-9000)) !!
    let next = schedule.next(at) ?? panic("no time")
    assert(show(next) == "2026-10-04 09:00:00 -02:30")
}
