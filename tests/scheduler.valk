use cron
use valk.sync
use valk.time

class Stats {
    runs: uint (0)
    active: uint (0)
    most_active: uint (0)
    finished: uint (0)
    // The largest distance of a start from the whole second, in microseconds
    worst_start: uint (0)
}

fn track(stats: Stats, work_ms: uint) {
    let late = time.unix_us() % 1_000_000
    if late > stats.worst_start : stats.worst_start = late
    stats.runs++
    stats.active++
    if stats.active > stats.most_active : stats.most_active = stats.active
    if work_ms > 0 : time.sleep_ms(work_ms)
    stats.active--
    stats.finished++
}

fn run_for(scheduler: cron.Scheduler, ms: uint) {
    let stop: atomic sync.CancelToken = sync.CancelToken.new() !!
    stop.cancel_after(ms)
    scheduler.run(stop) !!
}

test "a job runs on the second, without drift" {
    let scheduler = cron.Scheduler.new(time.utc())
    let stats = Stats {}
    let job = scheduler.add("* * * * * *", fn() { track(stats, 0) }) !!
    run_for(scheduler, 3500)
    println("worst start " + stats.worst_start + "us after the second")
    assert(stats.runs >= 3 && stats.runs <= 4)
    assert(job.runs == stats.runs)
    assert(stats.worst_start < 100_000)
}

test "a busy job skips its runs, or overlaps when allowed" {
    let skipping = cron.Scheduler.new(time.utc())
    let skip_stats = Stats {}
    let skip_job = skipping.add("* * * * * *", fn() { track(skip_stats, 2200) }) !!

    let overlapping = cron.Scheduler.new(time.utc())
    let overlap_stats = Stats {}
    let overlap_job = overlapping.add("* * * * * *", fn() { track(overlap_stats, 2200) }) !!
    overlap_job.overlap = true

    // Both schedulers run side by side on this thread
    let a = co run_for(skipping, 3500)
    let b = co run_for(overlapping, 3500)
    await a
    await b
    assert(skip_stats.most_active == 1)
    assert(skip_job.skipped >= 1)
    assert(skip_stats.runs + skip_job.skipped >= 3)
    assert(overlap_stats.most_active >= 2)
    assert(overlap_job.skipped == 0)
    // run waits for the runs in progress
    assert(skip_stats.active == 0 && overlap_stats.active == 0)
    assert(overlap_stats.finished == overlap_stats.runs)
}

test "shutdown waits for a run in progress" {
    let scheduler = cron.Scheduler.new(time.utc())
    let stats = Stats {}
    scheduler.add("* * * * * *", fn() { track(stats, 1500) }) !!
    let started = time.mono_ms()
    run_for(scheduler, 1200)
    assert(stats.runs == 1)
    assert(stats.finished == 1)
    assert(time.mono_ms() - started >= 1500)
}

test "jobs are added, found and removed while running" {
    let scheduler = cron.Scheduler.new(time.utc())
    let once = Stats {}
    let added = Stats {}
    scheduler.add("* * * * * *", fn() {
        track(once, 0)
        scheduler.remove("once")
        scheduler.add("* * * * * *", fn() { track(added, 0) }, "added") _
    }, "once") !!
    let late = scheduler.add("0 0 1 1 *", fn() {}, "late") !!

    let refused = Stats {}
    scheduler.add("* * * * *", fn() {}, "late") ! {
        assert(E is .exists)
        assert(E.message == "A job named \"late\" already exists")
        refused.runs++
    }
    assert(refused.runs == 1)
    scheduler.add("* * * *", fn() {}) ! {
        assert(E is .syntax)
    }

    assert(isset(scheduler.get("late")))
    let next = late.next_run() ?? panic("no next run")
    assert(next.month() == 1 && next.day() == 1 && next.hour() == 0)
    assert(next.zone().name == "UTC")

    run_for(scheduler, 3500)
    assert(once.runs == 1)
    assert(added.runs >= 1)
    assert(!isset(scheduler.get("once")))
    assert(isset(scheduler.get("added")))
    assert(scheduler.remove("late"))
    assert(!scheduler.remove("late"))
    assert(!isset(late.next_run()))
}

test "paused jobs do not fire and resume without catching up" {
    let scheduler = cron.Scheduler.new(time.utc())
    let stats = Stats {}
    let job = scheduler.add("* * * * * *", fn() { track(stats, 0) }, "ticker") !!

    // Pause before run: stays paused, no next_run, does not fire while paused
    job.pause()
    assert(job.paused && job.is_paused())
    assert(!isset(job.next_run()))

    let stop: atomic sync.CancelToken = sync.CancelToken.new() !!
    let running = co scheduler.run(stop)

    time.sleep_ms(2200)
    assert(stats.runs == 0)
    assert(job.runs == 0)
    assert(job.skipped == 0)
    assert(job.is_paused())

    // Resume computes a strictly future next_run and does not burst-fire missed runs
    let before_s = (time.unix_us() / 1_000_000).to(int)
    job.resume()
    assert(!job.paused && !job.is_paused())
    let next = job.next_run() ?? panic("no next run after resume")
    assert(next.unix_seconds() > before_s)

    time.sleep_ms(2300)
    // Pause again via scheduler convenience method; runs stop immediately
    assert(scheduler.pause("ticker"))
    assert(job.is_paused())
    assert(!isset(job.next_run()))
    let runs_at_pause = stats.runs
    assert(runs_at_pause >= 1 && runs_at_pause <= 3)

    time.sleep_ms(1600)
    assert(stats.runs == runs_at_pause)

    stop.cancel()
    await running !!
}

test "pausing while a run is in progress lets it finish cleanly" {
    let scheduler = cron.Scheduler.new(time.utc())
    let stats = Stats {}
    let job = scheduler.add("* * * * * *", fn() { track(stats, 1200) }, "slow") !!

    let stop: atomic sync.CancelToken = sync.CancelToken.new() !!
    let running = co scheduler.run(stop)

    // Wait for first run to start
    let waited: uint = 0
    while stats.active == 0 && waited < 2000 {
        time.sleep_ms(20)
        waited += 20
    }
    assert(stats.active == 1 && job.is_running())

    // Pause while the run is in progress
    assert(scheduler.pause("slow"))
    assert(job.is_paused())
    assert(job.is_running())

    // Wait past the completion of the in-progress run and another full second
    time.sleep_ms(2200)
    assert(stats.runs == 1)
    assert(stats.finished == 1)
    assert(stats.active == 0 && !job.is_running())
    assert(job.skipped == 0)

    // Resume via scheduler and confirm it runs again
    assert(scheduler.resume("slow"))
    assert(!job.is_paused())
    time.sleep_ms(1500)
    assert(stats.runs >= 2)

    stop.cancel()
    await running !!
    assert(stats.finished == stats.runs)
}

test "scheduler pause and resume handle missing and removed jobs" {
    let scheduler = cron.Scheduler.new(time.utc())
    let job = scheduler.add("0 0 1 1 *", fn() {}, "annual") !!

    assert(!scheduler.pause("missing"))
    assert(!scheduler.resume("missing"))

    // Pause and idempotent double-pause
    assert(scheduler.pause("annual"))
    assert(scheduler.pause("annual"))
    assert(job.paused && job.is_paused())
    assert(!isset(job.next_run()))

    // Resume and idempotent double-resume
    assert(scheduler.resume("annual"))
    assert(scheduler.resume("annual"))
    assert(!job.paused && !job.is_paused())
    assert(isset(job.next_run()))

    // Removing a paused job prevents resuming it
    assert(scheduler.pause("annual"))
    assert(scheduler.remove("annual"))
    assert(!scheduler.pause("annual"))
    assert(!scheduler.resume("annual"))
    job.resume()
    assert(!isset(job.next_run()))
}
